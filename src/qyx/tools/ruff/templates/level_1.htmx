<table id="level_1" class="striped">
  <thead>
    <tr>
      <th scope="col" style="text-align: left">Rule</th>
      <th scope="col" style="text-align: right">Count</th>
      <th scope="col" style="text-align: left">Message</th>
    </tr>
  </thead>
  <tbody>
    {% for row in ruff_1.rows %}
    <tr>
      <td style="text-align: left" >{{ row.rule_code             }}</td>
      <td style="text-align: right">{{ "{:,d}".format(row.count) }}</td>
      <td style="text-align: left" >{{ row.rule_name             }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<script>new Tablesort(document.getElementById('level_1'));</script>

{% if ty_d %}

<section>

  <details name="details" open>
    <summary>Summary</summary>
    {% include "ty::level_0.htmx" %}
  </details>

  <details name="details">
    <summary>By Check</summary>
    {% include "ty::level_1.htmx" %}
  </details>

  <details name="details">
    <summary>By Directory</summary>
    {% include "ty::level_2.htmx" %}
  </details>

  <details name="details">
    <summary>File</summary>
    {% include "ty::level_3.htmx" %}
  </details>

  <details name="details">
    <summary>Trend</summary>
    <div class="bordered">
      {{ ty_h }}
    </div>
  </details>

</section>

<hr />

<h6>As Of {{ ty_as_of }}</h6>

{% else %}

<p>Congratulations!...NO ty issues found.</p>

{% endif %}

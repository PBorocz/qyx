<table id="level_3" class="striped">
  <thead>
    <tr>
      <th scope="col" style="text-align: left">File</th>
      <th scope="col" style="text-align: left">Check</th>
      <th scope="col" style="text-align: left">Description</th>
    </tr>
  </thead>
  <tbody>
    {% for row in ty_3.rows %}
    <tr>
      <td style="text-align: left">{{ row.directory }}/{{ row.filename }} [{{ row.line }}]</td>
      <td style="text-align: left">{{ row.check_name }}</td>
      <td style="text-align: left">{{ row.description }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<script>new Tablesort(document.getElementById('level_3'));</script>

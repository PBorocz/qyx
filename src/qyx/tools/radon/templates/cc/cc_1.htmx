<table id="level_1" class="striped">
  <thead>
    <tr>
      <th scope="col" style="text-align: left"  >Directory</th>
      <th scope="col" style="text-align: left"  >Entity Type</th>
      <th scope="col" style="text-align: right" >Complexity</th>
      <th scope="col" style="text-align: center">Grade</th>
    </tr>
  </thead>
  <tbody>
    {% for row in cc_1.rows %}
    <tr>
      <td style="text-align: left"  >{{ row.directory                   }}</td>
      <td style="text-align: left"  >{{ row.entity_type                 }}</td>
      <td style="text-align: right" >{{ "{:.2f}".format(row.complexity) }}</td>
      <td style="text-align: center; color: var(--pico-muted-color); background-color: {{ row.metric.color }}">{{ row.metric.grade }}
    </tr>
    {% endfor %}
  </tbody>
</table>
<script>new Tablesort(document.getElementById('level_1'));</script>

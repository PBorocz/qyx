<table>
  <thead>
    <tr>
      <th scope="col" style="text-align: left">Entity Type</th>
      <th scope="col" style="text-align: right">Complexity</th>
    </tr>
  </thead>
  <tbody>
    {% for row in cc_0.rows %}
    <tr>
      {# FIXME: Make this RadonCcEntityType(row.entity_type).plural #}
      <td style="text-align: left">{{ row.entity_type }}</td>
      <td style="text-align: right">{{ "{:.1f}".format(row.complexity) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

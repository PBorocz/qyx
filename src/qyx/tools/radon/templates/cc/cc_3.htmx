<table id="level_3" class="striped">
  <thead>
    <tr>
      <th scope="col" style="text-align: left"  >Directory</th>
      <th scope="col" style="text-align: left"  >File</th>
      <th scope="col" style="text-align: left"  >Entity Name</th>
      <th scope="col" style="text-align: left"  >Entity Type</th>
      <th scope="col" style="text-align: right" >Complexity</th>
      <th scope="col" style="text-align: center">Rank</th>
    </tr>
  </thead>
  <tbody>
    {% for row in cc_3.rows %}
    <tr>
      <td style="text-align: left"  >{{ row.directory                   }}</td>
      <td style="text-align: left"  >{{ row.filename                    }}</td>
      <td style="text-align: left"  >{{ row.entity_type                 }}</td>
      <td style="text-align: left"  >{{ row.entity_name                 }}</td>
      <td style="text-align: right" >{{ "{:.2f}".format(row.complexity) }}</td>
      <td style="text-align: center">{{ row.rank                        }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<script>new Tablesort(document.getElementById('level_3'));</script>

<table id="level_3" class="striped">
  <thead>
    <tr>
      <th scope="col" style="text-align: left">File</th>
      <th scope="col" style="text-align: left">Name</th>
      {% for thead in hal_3.thead %}
        <th scope="col" style="text-align: right">{{ thead }}</th>
      {% endfor %}
    </tr>
  </thead>
  <tbody>
    <tr>
      {% for tbody in hal_3.tbody %}
      <td style="text-align: left">{{ tbody.directory_filename }}</td>
      <td style="text-align: left">{{ tbody.name }}</td>
      {% for value in tbody.values %}
        <td style="text-align: right">{{ value }}</td>
      {% endfor %}
    </tr>
    {% endfor %}
  </tbody>
</table>
<script>new Tablesort(document.getElementById('level_3'));</script>
